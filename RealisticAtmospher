    config.WaterTransparency = v
    if active and Terrain then Terrain.WaterTransparency = v end
end)

createSettingRow("Atmos Density", config.AtmosphereDensity, 0.02, 0, 1, function(v)
    config.AtmosphereDensity = v
    if active then
        local atmos = Lighting:FindFirstChild("RealAtmosphere")
        if atmos then atmos.Density = v end
    end
end)

createSettingRow("Fog End", config.FogEnd, 5000, 1000, 200000, function(v)
    config.FogEnd = v
    if active then Lighting.FogEnd = v end
end)

createSettingRow("Sun Intensity", config.SunIntensity, 0.05, 0, 1, function(v)
    config.SunIntensity = v
    if active then
        local sun = Lighting:FindFirstChild("RealSun")
        if sun then sun.Intensity = v end
    end
end)

-- Atmosphere Butonuna Tıklama Olayı (Çerçeve ve Renk Geri Bildirimi Eklendi)
